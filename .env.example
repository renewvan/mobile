# Copy to `.env` before `npx expo start` / building — Expo inlines
# EXPO_PUBLIC_* vars into the JS bundle at build time (see
# docs.expo.dev/guides/environment-variables). A production build (EAS
# Build / sideloaded APK) needs these set before building, same role as
# renewvan/dashboard's VITE_* vars.

# Mosquitto's WS listener as reachable from a phone on the van's network
# (not a container-internal hostname) — must be reachable from wherever
# the phone actually is (the van's own WiFi, or a wider network/VPN if
# checking status from outside the van).
EXPO_PUBLIC_MQTT_WS_URL=ws://<host>:9001

# Read-scoped credentials. Leave blank while the broker allows anonymous
# access (hub's reference docker/mosquitto/config).
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=

# Optional JSON override for the relay id -> label mapping shown on the
# Switches tab (app-side only, not a wire field). See
# src/config/relayLabels.ts for the built-in defaults.
# EXPO_PUBLIC_RELAY_LABELS={"lights_ceiling":"Ceiling lights"}
